DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=django_wiki
POSTGRES_USER=django_wiki
POSTGRES_PASSWORD=django_wiki
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Base de datos administrada: si existe, tiene prioridad sobre las variables POSTGRES_* anteriores.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/base_de_datos?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:contraseña@host:5432/base_de_datos?sslmode=require

# Variables individuales equivalentes, proporcionadas por algunos servicios.
PGHOST=host
PGHOST_UNPOOLED=host
PGUSER=usuario
PGDATABASE=base_de_datos
PGPASSWORD=contraseña

# Variables compatibles con plantillas de PostgreSQL administrado.
POSTGRES_URL=postgresql://usuario:contraseña@host:5432/base_de_datos?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://usuario:contraseña@host:5432/base_de_datos?sslmode=require
POSTGRES_DATABASE=base_de_datos
POSTGRES_URL_NO_SSL=postgresql://usuario:contraseña@host:5432/base_de_datos
POSTGRES_PRISMA_URL=postgresql://usuario:contraseña@host:5432/base_de_datos?sslmode=require
